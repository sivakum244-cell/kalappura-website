# =============================================================================
# KALAPPURA HOUSEBOATS - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# =============================================================================

# DATABASE
# --------
# Using SQLite for simplicity (file-based, no server needed).
# For production with PostgreSQL, use: postgresql://user:password@host:5432/dbname
DATABASE_URL="file:./dev.db"

# EMAIL CONFIGURATION (SMTP)
# --------------------------
# Configure your SMTP server for sending booking emails.
# For Gmail: smtp.gmail.com, port 587
# For Outlook: smtp-mail.outlook.com, port 587
# For custom domain: check your hosting provider's SMTP settings
#
# IMPORTANT: For Gmail, you need to use an "App Password" (not your login password).
# Go to: Google Account > Security > 2-Step Verification > App Passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# SENDER EMAIL
# The "from" address that appears in booking emails
SMTP_FROM_NAME="Kalappura Houseboats & Tours"
SMTP_FROM_EMAIL="bookings@kalappurahouseboats.com"

# ADMIN EMAIL
# Where admin booking notifications are sent
ADMIN_EMAIL="info@kalappurahouseboats.com"

# SITE URL
# Your website's public URL (used in emails for links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ADMIN DASHBOARD PASSWORD
# Simple password protection for the admin dashboard
# Change this to a strong password in production!
ADMIN_PASSWORD="kalappura2025"


# =============================================================================
# SUPABASE (Database, Auth, Storage, Realtime)
# =============================================================================
# Create a project at: https://supabase.com
#
# After creating the project:
# 1. Settings > API → Copy URL and keys below
# 2. Settings > Database → Copy connection strings for DATABASE_URL / DIRECT_URL
# 3. Storage → Create buckets: "room-images" (public), "gallery" (public)
# 4. Authentication → Email provider is enabled by default
# 5. Database > Replication → Enable realtime for "Booking" table

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# PostgreSQL Connection Strings (from Supabase Settings > Database)
# Pooled connection (for Prisma with connection pooling):
# DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (for Prisma migrations):
# DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
