# =============================================================================
# KALAPPURA HOUSEBOATS - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# =============================================================================

# DATABASE
# --------
# Using SQLite for simplicity (file-based, no server needed).
# For production with PostgreSQL, use: postgresql://user:password@host:5432/dbname
DATABASE_URL="file:./dev.db"

# EMAIL CONFIGURATION (SMTP)
# --------------------------
# Configure your SMTP server for sending booking emails.
# For Gmail: smtp.gmail.com, port 587
# For Outlook: smtp-mail.outlook.com, port 587
# For custom domain: check your hosting provider's SMTP settings
#
# IMPORTANT: For Gmail, you need to use an "App Password" (not your login password).
# Go to: Google Account > Security > 2-Step Verification > App Passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# SENDER EMAIL
# The "from" address that appears in booking emails
SMTP_FROM_NAME="Kalappura Houseboats & Tours"
SMTP_FROM_EMAIL="bookings@kalappurahouseboats.com"

# ADMIN EMAIL
# Where admin booking notifications are sent
ADMIN_EMAIL="info@kalappurahouseboats.com"

# SITE URL  (CANONICAL / SEO CRITICAL)
# ------------------------------------
# The single preferred, indexable origin. It MUST be the www HTTPS variant so
# the canonical tag matches the URL all variants (http, http://www, https,
# https://www) redirect to. Do NOT use a trailing slash and do NOT use the
# bare apex (non-www) host here.
#   Production (Vercel Project → Settings → Environment Variables):
#     NEXT_PUBLIC_SITE_URL="https://www.alleppeyhouseboat.online"
#   Local development:
#     NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://www.alleppeyhouseboat.online"

# =============================================================================
# GOOGLE ANALYTICS 4 & CONVERSION TRACKING  (REQUIRED FOR ANALYTICS)
# =============================================================================
# 1. Create a GA4 property at https://analytics.google.com
# 2. Admin → Data Streams → Web → copy the Measurement ID (format: G-XXXXXXXXXX)
# 3. Paste it below AND in the Vercel project environment variables.
# Until a real ID starting with "G-" (not the placeholder) is provided, the
# analytics script is intentionally NOT injected.
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Optional: Google Tag Manager container (format: GTM-XXXXXXX). Leave the
# placeholder to disable GTM. If you use GTM, you can route GA4 through it
# instead of setting NEXT_PUBLIC_GA_ID directly.
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# Optional: Google Ads conversion tracking (format: AW-XXXXXXXXXX) + labels.
NEXT_PUBLIC_GOOGLE_ADS_ID="AW-XXXXXXXXXX"
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=""
# Optional: Meta (Facebook) Pixel ID.
NEXT_PUBLIC_FB_PIXEL_ID=""

# ADMIN DASHBOARD PASSWORD
# Simple password protection for the admin dashboard
# Change this to a strong password in production!
ADMIN_PASSWORD="kalappura2025"


# =============================================================================
# SUPABASE (Database, Auth, Storage, Realtime)
# =============================================================================
# Create a project at: https://supabase.com
#
# After creating the project:
# 1. Settings > API → Copy URL and keys below
# 2. Settings > Database → Copy connection strings for DATABASE_URL / DIRECT_URL
# 3. Storage → Create buckets: "room-images" (public), "gallery" (public)
# 4. Authentication → Email provider is enabled by default
# 5. Database > Replication → Enable realtime for "Booking" table

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# PostgreSQL Connection Strings (from Supabase Settings > Database)
# Pooled connection (for Prisma with connection pooling):
# DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (for Prisma migrations):
# DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ============================================================================
# RAZORPAY PAYMENT GATEWAY
# Get keys from Razorpay Dashboard > Settings > API Keys
# ============================================================================
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"
