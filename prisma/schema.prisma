// Kalappura Houseboats & Tours - Database Schema (Supabase PostgreSQL)
// Updated: force fresh deploy

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Booking {
  id        String   @id @default(cuid())
  bookingId String   @unique // e.g., KHB-20260725-0001

  // Guest Information
  guestName String
  mobile    String
  email     String?
  country   String   @default("India")

  // Stay Details
  checkIn   String
  checkOut  String
  eta       String

  // Guests (PAX)
  adults    Int      @default(2)
  children  Int      @default(0)
  infants   Int      @default(0)

  // Accommodation
  roomType      String
  numberOfRooms Int      @default(1)

  // Preferences
  foodRequirements   String   @default("")
  foodAllergyDetails String   @default("")
  specialRequests    String   @default("")
  additionalNotes    String   @default("")
  paymentPreference  String   @default("pay-at-property")

  // Attribution (marketing source tracking)
  utmSource String   @default("")
  utmMedium String   @default("")
  utmCampaign String @default("")
  sourceLabel String @default("")

  // System
  status    String   @default("Pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([checkIn])
  @@index([createdAt])
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      String   // YYYY-MM-DD format
  roomType  String   // standard-cabin, double-twin-room, suite-river-view, or "all"
  reason    String   @default("Booked on Booking.com")
  createdAt DateTime @default(now())

  @@unique([date, roomType])
  @@index([date])
  @@index([roomType])
}

model RoomRate {
  id        String   @id @default(cuid())
  date      String   // YYYY-MM-DD
  roomType  String   // standard-cabin, double-twin-room, suite-river-view
  price     Int      // Price in INR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, roomType])
  @@index([date])
  @@index([roomType])
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @default("")
  content     String   // Markdown or HTML content
  coverImage  String   @default("")
  author      String   @default("Kalappura Houseboats")
  category    String   @default("travel")
  tags        String   @default("") // Comma-separated
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([slug])
  @@index([category])
}

model GuestPhoto {
  id          String   @id @default(cuid())
  guestName   String
  bookingId   String   @default("") // Optional reference
  caption     String   @default("")
  imageUrl    String   // Stored image path or URL
  approved    Boolean  @default(false)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([approved])
  @@index([createdAt])
}
